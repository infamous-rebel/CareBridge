# CareBridge environment configuration template.
# Copy to .env and fill in real values. NEVER commit .env — it holds secrets.

# ══════════════════════════════════════════════════════════════════════════
# LLM PROVIDER — selects the model that drives the Supervisor Agent
# ══════════════════════════════════════════════════════════════════════════
# One variable decides the provider. Switching providers is an env change only:
# no code edit, no rebuild (see src/runtime/model_factory.py).
#
#   LLM_PROVIDER = gemini | groq | bedrock | anthropic | openai | ollama | litellm
#
# REQUIRED per provider:
#   gemini     -> GEMINI_API_KEY
#   groq       -> GROQ_API_KEY
#   anthropic  -> ANTHROPIC_API_KEY
#   openai     -> OPENAI_API_KEY
#   bedrock    -> AWS credentials (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY,
#                 or an AWS profile / IAM role) — see commented block below
#   ollama     -> nothing; needs a local daemon at OLLAMA_HOST
#   litellm    -> LITELLM_MODEL, plus that provider's own API key
#
# If the selected provider's credential is missing the app STILL STARTS (so
# /health and /ready keep working) and logs a WARNING. Supervisor routing then
# degrades to the deterministic fallback path and LLM-dependent routes return
# 503 with a clear reason. Placeholders like "your-gemini-api-key" are treated
# as missing, not as credentials.

# Default: Google Gemini free tier — no credit card required.
# Get a key at https://aistudio.google.com/apikey
LLM_PROVIDER=gemini

# --- Google Gemini (DEFAULT — required when LLM_PROVIDER=gemini) ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# --- Groq (alternative FREE option, OpenAI-compatible endpoint) ---
# Uncomment all three lines to use Groq instead of Gemini.
# Get a key at https://console.groq.com/keys
#LLM_PROVIDER=groq
#GROQ_API_KEY=your-groq-api-key
#GROQ_MODEL=llama-3.3-70b-versatile

# --- Amazon Bedrock (for deployments with AWS access) ---
# Uncomment all five lines to use Bedrock. No API key: boto3 resolves
# credentials from the env, a shared profile, or an IAM role.
#LLM_PROVIDER=bedrock
#AWS_REGION=us-east-1
#AWS_ACCESS_KEY_ID=your-aws-access-key-id
#AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
#BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-20250514-v1:0

# --- Anthropic (direct API) ---
#LLM_PROVIDER=anthropic
#ANTHROPIC_API_KEY=your-anthropic-api-key
#ANTHROPIC_MODEL=claude-sonnet-4-20250514
#ANTHROPIC_MAX_TOKENS=4096

# --- OpenAI ---
#LLM_PROVIDER=openai
#OPENAI_API_KEY=your-openai-api-key
#OPENAI_MODEL=gpt-4o-mini

# --- Ollama (fully local: no API key, no data leaves the machine) ---
# Requires `ollama serve` running and the model pulled locally:
#   ollama pull llama3.1:8b
#LLM_PROVIDER=ollama
#OLLAMA_HOST=http://localhost:11434
#OLLAMA_MODEL=llama3.1:8b

# --- LiteLLM (universal fallback: any provider behind one adapter) ---
# LITELLM_MODEL is REQUIRED and uses provider-prefixed form; it also decides
# which provider's API key above is used.
#LLM_PROVIDER=litellm
#LITELLM_MODEL=gemini/gemini-2.5-flash

# --- Pharmacy MCP server (in-process / HTTP) ---
PHARMACY_MCP_URL=http://localhost:8001/mcp
PHARMACY_API_KEY=your-pharmacy-api-key

# --- Calendar MCP server (SSE external) ---
CALENDAR_MCP_URL=http://localhost:8002/sse
CALENDAR_API_KEY=your-calendar-api-key

# --- Delivery MCP server ---
DELIVERY_MCP_URL=http://localhost:8003/mcp
DELIVERY_API_KEY=your-delivery-api-key

# --- Messaging (SMS / email / phone escalation) ---
MESSAGING_MCP_URL=http://localhost:8004/mcp
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
SENDGRID_API_KEY=your-sendgrid-api-key

# --- Storage ---
# SQLite (development): audit.db in the project root
# PostgreSQL / Supabase (production)
DATABASE_URL=postgresql://user:password@localhost:5432/carebridge

# --- Auth (caregiver-facing API) ---
# JWT signing secret. MUST be >= 32 bytes and MUST be set when DEMO_MODE=false.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-secret-of-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# bcrypt cost factor. MUST be >= 12 when DEMO_MODE=false.
BCRYPT_ROUNDS=12

# --- API server ---
ENVIRONMENT=development
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
AUTH_RATE_LIMIT=60/minute
GLOBAL_RATE_LIMIT=300/minute
MAX_REQUEST_BYTES=1048576
JSON_LOGGING=true
LOG_LEVEL=INFO
# Separate SQLite DB for API users (the audit trail stays in audit.db).
AUTH_DB_PATH=auth.db

# --- Demo bootstrap (hackathon only) ---
# Seeds one demo caregiver on first startup when the users table is empty.
# Set DEMO_MODE=false in production: this disables seeding AND enforces the
# JWT-secret (>=32 bytes) and bcrypt (>=12 rounds) guardrails at startup.
DEMO_MODE=true
DEMO_USER_EMAIL=demo@carebridge.local
DEMO_USER_PASSWORD=CareBridgeDemo!2026
DEMO_USER_ROLE=caregiver_primary

# --- Build metadata (injected by CI / Docker build args) ---
BUILD_GIT_SHA=dev
BUILD_TIMESTAMP=

# --- Firebase Authentication (hybrid identity) ---
# Firebase handles identity (Google sign-in, email/password); the FastAPI
# backend issues business-claim JWTs and owns authorization.
# Set FIREBASE_AUTH_ENABLED=true and provide a service account to enable.
FIREBASE_AUTH_ENABLED=false
FIREBASE_PROJECT_ID=carebridge-675df
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-service-account.json
# For cloud deployment: paste the full service account JSON as a single line.
# Takes precedence over FIREBASE_SERVICE_ACCOUNT_PATH.
#FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}
